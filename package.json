{
  "name": "pagecast",
  "version": "0.1.0",
  "private": true,
  "description": "Pagecast — a personal podcast of book summaries, narrated in Hebrew.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "check": "eslint && prettier --check . && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "prepare": "husky",
    "ingest": "tsx scripts/ingest.ts",
    "voices": "tsx scripts/voices.ts",
    "set-voice": "tsx scripts/set-voice.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ulid": "^3.0.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,css,md,json}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix"
  }
}
